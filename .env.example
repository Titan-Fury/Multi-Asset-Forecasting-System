# Same structure as .env but with no real values — safe to commit / share.
# Copy this to .env and fill in real values.

# -----------------------------------------------------------------------------
# Google Cloud OAuth (rclone private client)
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-client-secret

# -----------------------------------------------------------------------------
# OpenRouter (free tier LLMs)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...

# -----------------------------------------------------------------------------
# Snowflake (Cortex LLMs)
# -----------------------------------------------------------------------------
SNOWFLAKE_CONNECTION_NAME=IU95928

# -----------------------------------------------------------------------------
# Free data APIs
# -----------------------------------------------------------------------------
NEWSAPI_KEY=
ALPHA_VANTAGE_KEY=
FINNHUB_KEY=
FRED_API_KEY=

# HuggingFace Hub (optional, but recommended)
# Get a Read-scope token at https://huggingface.co/settings/tokens
# Without this, model downloads (FinBERT, bge-reranker-base) and
# tokenizer fetches use anonymous rate limits which are easily hit.
# huggingface_hub auto-detects HF_TOKEN.
HF_TOKEN=

# Reddit (PRAW)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=omni-stocks/0.1 by your_username

# -----------------------------------------------------------------------------
# Local infra paths
# -----------------------------------------------------------------------------
DRIVE_MOUNT_POINT=Z:\
LOCAL_DATA_ROOT=C:\Omni_Stocks\data
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Dev tab password (Phase 24.14)
# -----------------------------------------------------------------------------
# When set, the dashboard's Dev tab is gated by this password. Required to
# run subprocess actions (model retraining, daily orchestrator, drive sync,
# cache purge). If empty/unset, the Dev tab is fully disabled with a message.
# Use a strong value — `python -c "import secrets; print(secrets.token_urlsafe(24))"`.
OMNI_DEV_PASSWORD=
